-- ============================================================
-- Project: Credit Portfolio Risk Analysis Using SQL
-- Author:  Hannah (Huong) Tran
-- Analysis B: Concentration Risk by Loan Purpose
-- Dataset: Lending Club accepted loans, 2007-2018
-- Table:   accepted_2007_to_2018Q4
--
-- Description: This script assesses whether the portfolio is
--              over-concentrated in particular loan purposes,
--              whether those segments carry hidden risk beyond
--              what their credit grade suggests, and how much
--              loss the portfolio would absorb under stress.
--
-- Frameworks:  Concentration risk, Herfindahl-Hirschman Index
--              (HHI), Expected / Net Loss, Stress Testing
--              (CFA Level I & II - Portfolio Management,
--              Credit Analysis)
--
-- Method note: Only RESOLVED loans (Fully Paid, Charged Off)
--              are used for default metrics. Loans that are
--              still Current or Late have no final outcome yet;
--              including them understates default rates,
--              especially for recent vintages and 60-month terms.
--
-- Data note:   If columns were imported as TEXT, use
--              CAST(column AS REAL) in numeric comparisons.
-- ============================================================


-- ============================================================
-- QUERY 1: How much money sits in each loan purpose, and what
--          does each purpose actually lose?
-- ============================================================
-- Context: Concentration risk starts with a simple question:
-- where is the exposure? But exposure alone is not enough.
-- We also measure loss three ways:
--   - default_rate_by_count : share of loans that charged off
--   - default_rate_by_dollar: share of dollars that charged off
--   - net_loss_rate_pct     : dollar loss AFTER recoveries
-- If dollar-based default exceeds count-based default, larger
-- loans are defaulting more often than smaller ones.
-- Net loss replaces the common "LGD = 100%" assumption with
-- what was actually lost after principal repaid and recoveries.

SELECT
    purpose,
    COUNT(*)                                                                        AS resolved_loans,
    ROUND(SUM(funded_amnt) / 1000000.0, 2)                                          AS exposure_millions,
    ROUND(100.0 * SUM(funded_amnt) /
        (SELECT SUM(funded_amnt)
         FROM accepted_2007_to_2018Q4
         WHERE loan_status IN ('Fully Paid', 'Charged Off')), 2)                    AS pct_of_exposure,
    ROUND(100.0 * AVG(loan_status = 'Charged Off'), 2)                              AS default_rate_by_count,
    ROUND(100.0 * SUM(CASE WHEN loan_status = 'Charged Off'
                           THEN funded_amnt ELSE 0 END) / SUM(funded_amnt), 2)      AS default_rate_by_dollar,
    ROUND(100.0 * SUM(CASE WHEN loan_status = 'Charged Off'
                           THEN funded_amnt - total_rec_prncp - recoveries
                           ELSE 0 END) / SUM(funded_amnt), 2)                       AS net_loss_rate_pct
FROM accepted_2007_to_2018Q4
WHERE loan_status IN ('Fully Paid', 'Charged Off')
GROUP BY purpose
ORDER BY exposure_millions DESC;


-- ============================================================
-- QUERY 2: Is a purpose risky because of the purpose itself,
--          or simply because of the grades of its borrowers?
-- ============================================================
-- Context: A purpose can look risky only because it contains
-- more low-grade borrowers (a mix effect). To separate the two:
--   expected_default_pct = default rate we would predict if the
--                          purpose behaved like the average loan
--                          of the SAME grade mix
--   excess_default_pp    = actual minus expected, in percentage
--                          points
-- A positive excess means the purpose carries risk that the
-- grade does not capture - hidden risk worth pricing or capping.
-- A negative excess means the purpose is safer than its grade
-- mix suggests.

WITH resolved AS (
    SELECT
        purpose,
        grade,
        (loan_status = 'Charged Off') AS bad
    FROM accepted_2007_to_2018Q4
    WHERE loan_status IN ('Fully Paid', 'Charged Off')
),
grade_pd AS (
    SELECT grade, AVG(bad) AS pd
    FROM resolved
    GROUP BY grade
)
SELECT
    r.purpose,
    COUNT(*)                                        AS loans,
    ROUND(100.0 * AVG(r.bad), 2)                    AS actual_default_pct,
    ROUND(100.0 * AVG(g.pd), 2)                     AS expected_default_pct,
    ROUND(100.0 * (AVG(r.bad) - AVG(g.pd)), 2)      AS excess_default_pp
FROM resolved r
JOIN grade_pd g ON r.grade = g.grade
GROUP BY r.purpose
ORDER BY excess_default_pp DESC;


-- ============================================================
-- QUERY 3: Purpose x Grade cross-segment view
-- ============================================================
-- Context: Drilling into the largest purposes by grade shows
-- where inside a big segment the losses actually come from.
-- Example: is debt_consolidation risk driven by a few weak
-- grades, or spread evenly? Small cells (under 500 loans) are
-- excluded because their default rates are statistically noisy.

SELECT
    purpose,
    grade,
    COUNT(*)                                                                        AS resolved_loans,
    ROUND(SUM(funded_amnt) / 1000000.0, 2)                                          AS exposure_millions,
    ROUND(100.0 * AVG(loan_status = 'Charged Off'), 2)                              AS default_rate_pct,
    ROUND(AVG(int_rate), 2)                                                         AS avg_interest_rate
FROM accepted_2007_to_2018Q4
WHERE loan_status IN ('Fully Paid', 'Charged Off')
  AND purpose IN ('debt_consolidation', 'credit_card', 'home_improvement', 'small_business')
GROUP BY purpose, grade
HAVING COUNT(*) >= 500
ORDER BY purpose, grade;


-- ============================================================
-- QUERY 4: How has purpose concentration changed over time?
-- ============================================================
-- Context: Concentration is a trend, not a snapshot. If the
-- share of one purpose rises year after year, the portfolio is
-- becoming less diversified. This also shows whether the lender
-- shifted toward riskier purposes (e.g. small_business) during
-- periods of rapid growth.

SELECT
    SUBSTR(issue_d, -4)                                                                 AS vintage,
    ROUND(SUM(funded_amnt) / 1000000.0, 1)                                              AS originated_millions,
    ROUND(100.0 * SUM(CASE WHEN purpose = 'debt_consolidation' THEN funded_amnt ELSE 0 END)
        / SUM(funded_amnt), 1)                                                          AS debt_consol_share_pct,
    ROUND(100.0 * SUM(CASE WHEN purpose = 'credit_card' THEN funded_amnt ELSE 0 END)
        / SUM(funded_amnt), 1)                                                          AS credit_card_share_pct,
    ROUND(100.0 * SUM(CASE WHEN purpose = 'small_business' THEN funded_amnt ELSE 0 END)
        / SUM(funded_amnt), 1)                                                          AS small_biz_share_pct
FROM accepted_2007_to_2018Q4
WHERE issue_d IS NOT NULL
GROUP BY vintage
ORDER BY vintage;


-- ============================================================
-- QUERY 5: Quantify concentration with HHI and Effective N
-- ============================================================
-- Context: The Herfindahl-Hirschman Index (HHI) is the sum of
-- squared portfolio shares. It ranges from 1/N (perfectly
-- diversified) to 1 (everything in one purpose).
-- Effective N = 1 / HHI converts the index into an intuitive
-- number: "this portfolio behaves as if it were spread evenly
-- across N purposes". If actual_num_purposes is 14 but
-- effective_num_purposes is about 2-3, diversification is
-- largely cosmetic.

WITH s AS (
    SELECT
        SUBSTR(issue_d, -4) AS vintage,
        purpose,
        SUM(funded_amnt)    AS amt
    FROM accepted_2007_to_2018Q4
    WHERE issue_d IS NOT NULL
    GROUP BY vintage, purpose
),
t AS (
    SELECT vintage, SUM(amt) AS tot
    FROM s
    GROUP BY vintage
)
SELECT
    s.vintage,
    ROUND(SUM((1.0 * s.amt / t.tot) * (1.0 * s.amt / t.tot)), 4)         AS hhi,
    ROUND(1.0 / SUM((1.0 * s.amt / t.tot) * (1.0 * s.amt / t.tot)), 1)   AS effective_num_purposes,
    COUNT(*)                                                             AS actual_num_purposes
FROM s
JOIN t ON s.vintage = t.vintage
GROUP BY s.vintage
ORDER BY s.vintage;


-- ============================================================
-- QUERY 6: Stress test - what if the worst historical vintage
--          repeated?
-- ============================================================
-- Context: Instead of an arbitrary "defaults double" scenario,
-- the stress multiplier is taken from the data itself:
--   multiplier = worst vintage default rate / overall default rate
-- Only vintages with more than 5,000 resolved loans are used so
-- that small early cohorts do not distort the result.
-- Each purpose's default rate is scaled by the multiplier and
-- capped at 100%. Stressed loss is shown in millions so the
-- biggest absolute risk contributors rank first.
-- Simplification: loss = exposure x default rate (LGD = 100%),
-- which is conservative compared with the net loss in Query 1.

WITH base AS (
    SELECT
        purpose,
        SUM(funded_amnt)                    AS exposure,
        AVG(loan_status = 'Charged Off')    AS pd
    FROM accepted_2007_to_2018Q4
    WHERE loan_status IN ('Fully Paid', 'Charged Off')
    GROUP BY purpose
),
v AS (
    SELECT AVG(loan_status = 'Charged Off') AS pd
    FROM accepted_2007_to_2018Q4
    WHERE loan_status IN ('Fully Paid', 'Charged Off')
      AND issue_d IS NOT NULL
    GROUP BY SUBSTR(issue_d, -4)
    HAVING COUNT(*) > 5000
),
m AS (
    SELECT MAX(pd) / (SELECT AVG(loan_status = 'Charged Off')
                      FROM accepted_2007_to_2018Q4
                      WHERE loan_status IN ('Fully Paid', 'Charged Off')) AS mult
    FROM v
)
SELECT
    b.purpose,
    ROUND(b.exposure / 1000000.0, 2)                            AS exposure_millions,
    ROUND(100.0 * b.pd, 2)                                      AS base_default_pct,
    ROUND(m.mult, 2)                                            AS stress_multiplier,
    ROUND(b.exposure * b.pd / 1000000.0, 2)                     AS base_loss_millions,
    ROUND(b.exposure * MIN(b.pd * m.mult, 1.0) / 1000000.0, 2)  AS stressed_loss_millions
FROM base b, m
ORDER BY stressed_loss_millions DESC;
